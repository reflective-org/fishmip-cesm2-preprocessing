#!/bin/bash
# Write the full FishMIP forcing set. Submit with:
#
#     qsub -A <PROJECT> scripts/write_all.pbs
#
# Re-submitting is safe and is the intended way to recover: complete files are
# skipped, truncated ones are rewritten. A 10-hour job that cannot resume is a
# 10-hour job you run twice.
#
#PBS -N fishmip-write
#PBS -q main
#PBS -l select=1:ncpus=128:mem=200GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o logs/

set -uo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1
mkdir -p logs output

module load conda
conda activate npl

# HDF5 takes file locks by default and locking on Lustre is unreliable enough
# that it can block forever rather than fail. A run hung here for 38 hours in
# state S with no output at all, which is worse than any crash.
export HDF5_USE_FILE_LOCKING=FALSE

export WEIGHTS="${WEIGHTS:-grids/gx1v7_to_fishmip_1deg_conserve.nc}"
export OUT_DIR="${OUT_DIR:-output}"

# The job is CPU bound, not I/O bound: a member measured 32m44s of user time
# against 35m55s wall, almost all of it zlib decompression on read and
# compression on write.
#
# Threads do not help. HDF5 is not thread-safe, so xarray serialises every
# netCDF read behind a global lock, and a member uses barely one core however
# many dask workers it is given. Parallelism has to come from running members
# as separate processes -- which is what this script does, so the dial that
# matters is CONCURRENT_MEMBERS, not DASK_WORKERS.
#
# 34 members at ~1 core and ~3 GB each: all of them at once fits inside one
# Derecho node's 128 cores and 200 GB, and finishes in about the time a single
# member takes.
CONCURRENT_MEMBERS="${CONCURRENT_MEMBERS:-34}"
export DASK_WORKERS="${DASK_WORKERS:-2}"

if [ ! -f "${WEIGHTS}" ]; then
    echo "weight file not found: ${WEIGHTS}" >&2
    echo "generate it first: python -m fishmip_cesm.make_weights --run" >&2
    exit 2
fi

python scripts/list_tasks.py > logs/tasks.txt
echo "$(wc -l < logs/tasks.txt) member(s), ${CONCURRENT_MEMBERS} at a time, ${DASK_WORKERS} dask workers each"

start=$(date +%s)
xargs -a logs/tasks.txt -d '\n' -P "${CONCURRENT_MEMBERS}" -I{} \
    bash scripts/write_one.sh {}
echo "elapsed: $(( ($(date +%s) - start) / 60 )) min"

echo
echo "=== what is still missing ==="
python -m fishmip_cesm.write_output --weights "${WEIGHTS}" --out-dir "${OUT_DIR}" \
    | grep -c "would write" \
    | xargs -I{} echo "{} file(s) planned in total; compare against:"
ls -1 "${OUT_DIR}"/*.nc 2>/dev/null | wc -l | xargs -I{} echo "{} file(s) written"
