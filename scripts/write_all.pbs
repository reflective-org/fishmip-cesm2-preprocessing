#!/bin/bash
# Write the full FishMIP forcing set. Submit with:
#
#     qsub -A <PROJECT> scripts/write_all.pbs
#
# Re-submitting is safe and is the intended way to recover: complete files are
# skipped, truncated ones are rewritten. A 10-hour job that cannot resume is a
# 10-hour job you run twice.
#
#PBS -N fishmip-write
#PBS -q main
#PBS -l select=1:ncpus=128:mem=200GB
#PBS -l walltime=08:00:00
#PBS -j oe
#PBS -o logs/

set -uo pipefail

cd "${PBS_O_WORKDIR:-$(pwd)}" || exit 1
mkdir -p logs output

module load conda
conda activate npl

export WEIGHTS="${WEIGHTS:-grids/gx1v7_to_fishmip_1deg_conserve.nc}"
export OUT_DIR="${OUT_DIR:-output}"

# The job is I/O bound. Concurrency is about keeping reads in flight, not about
# cores; each member peaks near 1-3 GB, so 16 x 4 sits inside 200 GB with room.
#
# Walltime is generous on purpose. A member measured well over the first
# estimate, and the per-variable timings the writer now prints are what should
# replace guesswork here. Re-submitting resumes, so an overrun is survivable --
# but an eight-hour ceiling costs nothing if the job finishes in two.
CONCURRENT_MEMBERS="${CONCURRENT_MEMBERS:-16}"
export DASK_WORKERS="${DASK_WORKERS:-4}"

if [ ! -f "${WEIGHTS}" ]; then
    echo "weight file not found: ${WEIGHTS}" >&2
    echo "generate it first: python -m fishmip_cesm.make_weights --run" >&2
    exit 2
fi

python scripts/list_tasks.py > logs/tasks.txt
echo "$(wc -l < logs/tasks.txt) member(s), ${CONCURRENT_MEMBERS} at a time, ${DASK_WORKERS} dask workers each"

start=$(date +%s)
xargs -a logs/tasks.txt -d '\n' -P "${CONCURRENT_MEMBERS}" -I{} \
    bash scripts/write_one.sh {}
echo "elapsed: $(( ($(date +%s) - start) / 60 )) min"

echo
echo "=== what is still missing ==="
python -m fishmip_cesm.write_output --weights "${WEIGHTS}" --out-dir "${OUT_DIR}" \
    | grep -c "would write" \
    | xargs -I{} echo "{} file(s) planned in total; compare against:"
ls -1 "${OUT_DIR}"/*.nc 2>/dev/null | wc -l | xargs -I{} echo "{} file(s) written"
